# ==== Google Cloud ====
GCP_PROJECT_ID=your-project-id

# Public source dataset and project-owned datasets
BQ_SOURCE_DATASET=bigquery-public-data.ga4_obfuscated_sample_ecommerce
BQ_QUERY_PROJECT=your-project-id
BQ_RAW_PROJECT=your-project-id        # project owning marketing_dss_raw
BQ_RAW_DATASET=marketing_dss_raw
BQ_RAW_TABLE=events_*
BQ_DWH_DATASET=marketing_dss

# Pub/Sub (shared by the Extract and Transform layers)
PUBSUB_TOPIC=ga4-events
PUBSUB_DLQ_TOPIC=ga4-events-dlq
PUBSUB_SUBSCRIPTION=ga4-events-sub

# Raw dataset written by Dataflow (publisher replays, pipeline writes events_YYYYMMDD)
RAW_DATASET=marketing_dss_raw

# ==== Extract ====
EXTRACT_START_DATE=2020-11-01
EXTRACT_END_DATE=2020-11-01         # narrow the range: LIMIT alone does not limit BigQuery scans
EXTRACT_LIMIT=100                   # positive value required for Sandbox replay tests
PUBLISH_RATE_PER_SEC=10              # 0 disables throttling; use a small value for Sandbox tests
REPLAY_BATCH_SIZE=1                  # raw payloads per emulator message; optional bounded-replay batching

# BigQuery free-tier safeguards
BQ_MAX_QUERY_BYTES=134217728          # 128 MiB per query; dry-run fails before execution if too large
BQ_USAGE_LOG=build/bigquery_usage.jsonl
BQ_MONTHLY_SCAN_BUDGET_GIB=50       # self-imposed project threshold, below the 1 TiB free quota

# ==== Dashboard ====
# mock = generated data, no GCP needed; bigquery = read core/marts in GCP_PROJECT_ID
DASHBOARD_DATA_SOURCE=mock          # switch to bigquery after the warehouse is ready
DASHBOARD_PORT=8501
# Default alert threshold (drop vs previous period); users adjust it in the app
ALERT_DEFAULT_THRESHOLD=0.2
