# ==== Google Cloud ====
GCP_PROJECT_ID=your-project-id

# Dataset nguồn (public) và dataset đích do nhóm tạo
BQ_SOURCE_DATASET=bigquery-public-data.ga4_obfuscated_sample_ecommerce
BQ_RAW_DATASET=marketing_dss_raw
BQ_DWH_DATASET=marketing_dss

# Pub/Sub
PUBSUB_TOPIC=ga4-events
PUBSUB_DLQ_TOPIC=ga4-events-dlq

# ==== Trích xuất ====
EXTRACT_START_DATE=2020-11-01
EXTRACT_END_DATE=2021-01-31

# ==== Dashboard ====
DASHBOARD_PORT=8501
# Ngưỡng cảnh báo mặc định (tỷ lệ giảm so với kỳ trước); người dùng chỉnh trong app
ALERT_DEFAULT_THRESHOLD=0.2
