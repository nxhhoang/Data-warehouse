# ==== Google Cloud ====
GCP_PROJECT_ID=your-project-id

# Public source dataset and project-owned datasets
BQ_SOURCE_DATASET=bigquery-public-data.ga4_obfuscated_sample_ecommerce
BQ_RAW_PROJECT=bigquery-public-data   # set to GCP_PROJECT_ID when reading pipeline-written tables
BQ_RAW_DATASET=ga4_obfuscated_sample_ecommerce
BQ_RAW_TABLE=events_*
BQ_DWH_DATASET=marketing_dss

# Pub/Sub (shared by the Extract and Transform layers)
PUBSUB_TOPIC=ga4-events
PUBSUB_DLQ_TOPIC=ga4-events-dlq
PUBSUB_SUBSCRIPTION=ga4-events-sub

# Raw dataset written by Dataflow (publisher replays, pipeline writes events_YYYYMMDD)
RAW_DATASET=marketing_dss_raw

# ==== Extract ====
EXTRACT_START_DATE=2020-11-01
EXTRACT_END_DATE=2021-01-31
EXTRACT_LIMIT=0                     # 0 = no limit; set a positive number when testing

# ==== Dashboard ====
DASHBOARD_PORT=8501
# Default alert threshold (drop vs previous period); users adjust it in the app
ALERT_DEFAULT_THRESHOLD=0.2
